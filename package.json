{
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  },
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "contributors": [
    "Alexandru Panturu <alex@dusk.network>",
    "Andrea Scartabelli <andrea@dusk.network>",
    "Kieran Hall <kieran@dusk.network>",
    "Norton Andreev <norton@dusk.network>"
  ],
  "description": "Component and utility library for building Dusk user interfaces",
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10.9.2"
  },
  "homepage": "https://dusk-network.github.io/duskit/",
  "license": "MPL-2.0",
  "name": "duskit",
  "packageManager": "npm@10.8.2",
  "private": true,
  "repository": "https://github.com/dusk-network/duskit",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "checks": "turbo run checks",
    "clean": "turbo run clean && rimraf package-lock.json && rimraf node_modules",
    "dev": "turbo run dev --no-cache --continue",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "release": "turbo run build && changeset publish",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "typecheck:watch": "turbo run typecheck:watch",
    "version-packages": "changeset version"
  },
  "type": "module",
  "workspaces": [
    "apps/workshop",
    "packages/array",
    "packages/components",
    "packages/css",
    "packages/currency",
    "packages/date",
    "packages/design-tokens",
    "packages/encoding",
    "packages/error",
    "packages/http",
    "packages/icons",
    "packages/math",
    "packages/promise",
    "packages/string",
    "packages/svelte-stores",
    "packages/test-helpers"
  ],
  "devDependencies": {
    "@changesets/cli": "2.29.4",
    "@dusk-network/eslint-config": "4.0.1",
    "@dusk-network/prettier-config": "1.1.0",
    "@eslint/js": "9.27.0",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-config-turbo": "2.5.3",
    "eslint-import-resolver-typescript": "4.3.5",
    "globals": "16.1.0",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "turbo": "2.5.3"
  }
}
