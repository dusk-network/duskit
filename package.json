{
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  },
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "contributors": [
    "Alexandru Panturu <alex@dusk.network>",
    "Andrea Scartabelli <andrea@dusk.network>",
    "Kieran Hall <kieran@dusk.network>",
    "Norton Andreev <norton@dusk.network>"
  ],
  "description": "Component and utility library for building Dusk user interfaces",
  "engines": {
    "node": ">=24.0.0",
    "npm": "11.18.0"
  },
  "homepage": "https://github.com/dusk-network/duskit#readme",
  "license": "MIT",
  "name": "duskit",
  "packageManager": "npm@11.18.0",
  "private": true,
  "repository": "https://github.com/dusk-network/duskit",
  "scripts": {
    "changeset": "changeset",
    "checks": "npm run checks --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && node scripts/clean.js package-lock.json node_modules",
    "format": "prettier .github scripts eslint.config.js package.json vitest.config.js --write && npm run format --workspaces --if-present",
    "format:check": "prettier .github scripts eslint.config.js package.json vitest.config.js --check && npm run format:check --workspaces --if-present",
    "lint": "eslint scripts && npm run lint --workspaces --if-present",
    "lint:fix": "eslint scripts --fix && npm run lint:fix --workspaces --if-present",
    "release": "changeset publish",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "version": "changeset version"
  },
  "type": "module",
  "workspaces": [
    "packages/array",
    "packages/css",
    "packages/date",
    "packages/encoding",
    "packages/error",
    "packages/http",
    "packages/icons",
    "packages/math",
    "packages/promise",
    "packages/string",
    "packages/svelte-actions",
    "packages/svelte-stores",
    "packages/test-helpers",
    "packages/components"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.8.4",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.4",
    "vite": "8.1.7",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
