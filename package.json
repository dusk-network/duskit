{
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  },
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "contributors": [
    "Alexandru Panturu <alex@dusk.network>",
    "Andrea Scartabelli <andrea@dusk.network>",
    "Kieran Hall <kieran@dusk.network>",
    "Norton Andreev <norton@dusk.network>"
  ],
  "description": "Component and utility library for building Dusk user interfaces",
  "engines": {
    "node": ">=24.0.0",
    "npm": "11.18.0"
  },
  "homepage": "https://dusk-network.github.io/duskit/",
  "license": "MIT",
  "name": "duskit",
  "packageManager": "npm@11.18.0",
  "private": true,
  "repository": "https://github.com/dusk-network/duskit",
  "scripts": {
    "build": "turbo run build",
    "build:storybook": "turbo run build --filter=@duskit/storybook",
    "changeset": "changeset",
    "checks": "turbo run checks",
    "clean": "turbo run clean && node scripts/clean.js package-lock.json node_modules docs",
    "dev": "turbo run dev --no-cache --continue",
    "dev:storybook": "turbo run dev --no-cache --continue --filter=@duskit/storybook",
    "docs": "typedoc",
    "format": "prettier .github scripts eslint.config.js package.json typedoc.config.js vitest.config.js --write && turbo run format",
    "format:check": "prettier .github scripts eslint.config.js package.json typedoc.config.js vitest.config.js --check && turbo run format:check",
    "lint": "eslint scripts && turbo run lint",
    "lint:fix": "eslint scripts --fix && turbo run lint:fix",
    "release": "turbo run build && changeset publish",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "typecheck:watch": "turbo run typecheck:watch",
    "version": "changeset version",
    "verify:release-ages": "node scripts/verify-package-release-ages.js --days 7"
  },
  "type": "module",
  "workspaces": [
    "apps/storybook",
    "packages/array",
    "packages/components",
    "packages/css",
    "packages/date",
    "packages/encoding",
    "packages/error",
    "packages/http",
    "packages/icons",
    "packages/math",
    "packages/promise",
    "packages/string",
    "packages/svelte-actions",
    "packages/svelte-stores",
    "packages/test-helpers"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@dusk-network/eslint-config": "4.0.1",
    "@dusk-network/prettier-config": "1.1.0",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-turbo": "2.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "globals": "17.7.0",
    "prettier": "3.8.4",
    "svelte": "5.56.4",
    "turbo": "2.10.0",
    "typedoc": "0.28.19",
    "typedoc-plugin-dt-links": "2.0.60",
    "typedoc-plugin-mdn-links": "5.1.1",
    "vite": "8.1.0",
    "vitest": "4.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "brace-expansion@<2": "1.1.18",
    "brace-expansion@>=5 <6": "5.0.8"
  }
}
