{
  "name": "duskit",
  "private": true,
  "description": "Component and utility library for building Dusk user interfaces",
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  },
  "contributors": [
    "Alexandru Panturu <alex@dusk.network>",
    "Andrea Scartabelli <andrea@dusk.network>",
    "Kieran Hall <kieran@dusk.network>",
    "Norton Andreev <norton@dusk.network>"
  ],
  "homepage": "https://dusk-network.github.io/duskit/",
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "repository": "https://github.com/dusk-network/duskit",
  "license": "MPL-2.0",
  "type": "module",
  "workspaces": [
    "apps/workshop",
    "packages/components",
    "packages/css",
    "packages/currency",
    "packages/design-tokens",
    "packages/error",
    "packages/http",
    "packages/icons",
    "packages/string",
    "packages/test-helpers"
  ],
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "checks": "turbo run checks",
    "clean": "turbo run clean && rimraf node_modules",
    "dev": "turbo run dev --no-cache --continue",
    "format:check": "turbo run format:check",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "release": "turbo run build && changeset publish",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "typecheck:watch": "turbo run typecheck:watch",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "2.27.1",
    "@dusk-network/eslint-config": "3.3.1",
    "@dusk-network/prettier-config": "1.1.0",
    "eslint": "8.57.0",
    "eslint-config-turbo": "1.13.2",
    "prettier": "3.2.5",
    "rimraf": "5.0.5",
    "turbo": "1.13.2"
  },
  "engines": {
    "node": ">=20.11.1",
    "npm": ">=10.2.4"
  }
}
