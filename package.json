{
	"name": "duskit",
	"private": true,
	"description": "Component library for building Dusk user interfaces",
	"homepage": "https://dusk-network.github.io/duskit/",
	"bugs": {
		"url": "https://github.com/dusk-network/issues"
	},
	"repository": "https://github.com/dusk-network/duskit",
	"license": "MPL-2.0",
	"author": "Kieran Hall <kieran@dusk.network>",
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"changeset": "changeset",
		"clean": "turbo run clean && rm -rf node_modules",
		"dev": "turbo run dev --no-cache --continue",
		"format": "pnpm exec prettier . -w --plugin-search-dir=.",
		"lint": "turbo run lint",
		"release": "turbo run build --filter=docs^... && changeset publish",
		"test": "echo \"Work in progress...\" && exit 1",
		"version-packages": "changeset version"
	},
	"devDependencies": {
		"@changesets/cli": "2.26.1",
		"@evilmartians/lefthook": "1.3.12",
		"lefthook": "1.3.12",
		"prettier": "2.8.8",
		"prettier-plugin-packagejson": "2.4.3",
		"prettier-plugin-svelte": "2.10.0",
		"prettier-plugin-tailwindcss": "0.0.0-insiders.6ba6faa",
		"turbo": "1.9.6"
	},
	"packageManager": "pnpm@8.5.1",
	"engines": {
		"node": "18.16.0",
		"pnpm": "^8.5.0"
	}
}
