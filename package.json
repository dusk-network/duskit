{
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  },
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "contributors": [
    "Alexandru Panturu <alex@dusk.network>",
    "Andrea Scartabelli <andrea@dusk.network>",
    "Kieran Hall <kieran@dusk.network>",
    "Norton Andreev <norton@dusk.network>"
  ],
  "description": "Component and utility library for building Dusk user interfaces",
  "engines": {
    "node": ">=22.15.0",
    "npm": ">=10.9.2"
  },
  "homepage": "https://dusk-network.github.io/duskit/",
  "license": "MPL-2.0",
  "name": "duskit",
  "packageManager": "npm@10.9.2",
  "private": true,
  "repository": "https://github.com/dusk-network/duskit",
  "scripts": {
    "build": "turbo run build",
    "build:storybook": "turbo run build --filter=@duskit/storybook",
    "build:tokens": "turbo run build --filter=@duskit/design-tokens",
    "changeset": "changeset",
    "checks": "turbo run checks",
    "clean": "turbo run clean && rimraf package-lock.json && rimraf node_modules && rimraf docs",
    "dev": "turbo run dev --no-cache --continue",
    "dev:storybook": "turbo run dev --no-cache --continue --filter=@duskit/storybook",
    "docs": "typedoc",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "release": "turbo run build && changeset publish",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "typecheck:watch": "turbo run typecheck:watch",
    "version": "changeset version"
  },
  "type": "module",
  "workspaces": [
    "apps/storybook",
    "packages/array",
    "packages/components",
    "packages/css",
    "packages/date",
    "packages/design-tokens",
    "packages/encoding",
    "packages/error",
    "packages/http",
    "packages/icons",
    "packages/math",
    "packages/promise",
    "packages/string",
    "packages/svelte-stores",
    "packages/test-helpers"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.30.0",
    "@dusk-network/eslint-config": "4.0.1",
    "@dusk-network/prettier-config": "1.1.0",
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-turbo": "2.8.19",
    "eslint-import-resolver-typescript": "4.4.4",
    "globals": "17.4.0",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "svelte": "5.54.0",
    "turbo": "2.8.19",
    "typedoc": "0.28.17",
    "typedoc-plugin-dt-links": "2.0.46",
    "typedoc-plugin-mdn-links": "5.1.1",
    "vitest": "4.1.0",
    "vite": "7.3.1"
  },
  "overrides": {
    "lodash": "4.17.23",
    "markdown-it": "14.1.1",
    "tar-fs": "2.1.4"
  }
}
