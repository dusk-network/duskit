{
  "name": "@duskit/storybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "node -e \"const fs = require('node:fs'); for (const path of process.argv.slice(1)) fs.rmSync(path, { force: true, recursive: true })\" node_modules storybook-static",
    "dev": "storybook dev -p 6006",
    "build": "storybook build --output-dir storybook-static"
  },
  "dependencies": {
    "@duskit/components": "*",
    "@duskit/css": "*"
  },
  "devDependencies": {
    "@mdi/js": "7.4.47",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-themes": "10.4.6",
    "@storybook/svelte-vite": "10.4.6",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "remark-gfm": "4.0.1",
    "storybook": "10.4.6",
    "svelte": "5.56.4",
    "vite": "8.1.0"
  }
}
