{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "removeComments": false,
    "resolveJsonModule": true,
    "skipLibCheck": false,
    "types": ["node"],
    "lib": ["ESNext", "DOM"],
    "noEmit": true,
    "sourceMap": false,
    "preserveWatchOutput": true,
    "declaration": false,
    // Strict
    "noImplicitAny": false,
    "noImplicitThis": true,
    "noUnusedParameters": true,
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    // Volar
    "jsx": "preserve"
  },
  "include": ["src"],
  "exclude": [
    "../../node_modules",
    "node_modules",
    "generated/**/*",
    "dist/**/*",
    "src/**/*.spec.js"
  ]
}
