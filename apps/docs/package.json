{
	"name": "@dusk-network/docs",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"deploy": "touch build/.nojekyll && gh-pages -d build -t true",
		"dev": "vite dev",
		"format": "prettier --write --ignore-path=../../.prettierignore .",
		"lint": "prettier --check --ignore-path=../../.prettierignore . && eslint \".\"",
		"preview": "vite preview"
	},
	"dependencies": {
		"@dusk-network/button": "workspace:*",
		"@dusk-network/card": "workspace:*",
		"@dusk-network/content": "workspace:*",
		"@dusk-network/control": "workspace:*",
		"@dusk-network/cookie-banner": "workspace:*",
		"@dusk-network/duskit-examples": "workspace:*",
		"@dusk-network/footer": "workspace:*",
		"@dusk-network/group": "workspace:*",
		"@dusk-network/heading": "workspace:*",
		"@dusk-network/menu": "workspace:*",
		"@dusk-network/meta": "workspace:*",
		"@dusk-network/navbar": "workspace:*",
		"@dusk-network/text": "workspace:*",
		"@dusk-network/toggle": "workspace:*",
		"@dusk-network/tokens": "workspace:*",
		"@dusk-network/utilities": "workspace:*"
	},
	"devDependencies": {
		"@dusk-network/eslint-config": "1.2.8",
		"@sveltejs/adapter-static": "2.0.2",
		"@sveltejs/kit": "1.16.2",
		"eslint": "8.40.0",
		"highlight.js": "11.8.0",
		"js-cookie": "3.0.5",
		"prettier": "2.8.8",
		"prettier-plugin-packagejson": "2.4.3",
		"prettier-plugin-svelte": "2.10.0",
		"prettier-plugin-tailwindcss": "0.2.8",
		"svelte": "3.59.1",
		"svelte-check": "3.3.2",
		"svelte-highlight": "7.2.1",
		"svelte-preprocess": "5.0.3",
		"vite": "4.3.5"
	}
}
