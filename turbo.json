{
  "$schema": "https://turbo.build/schema.json",
  "experimentalUI": true,
  "pipeline": {
    "build": {
      "outputs": [".histoire/dist/**"]
    },
    "checks": {
      "outputMode": "errors-only"
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format:check": {},
    "format": {},
    "lint": {},
    "lint:fix": {},
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "interactive": true,
      "persistent": true
    },
    "typecheck": {},
    "typecheck:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
