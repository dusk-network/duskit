{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": [".histoire/dist/**", "dist/**"]
    },
    "checks": {
      "outputLogs": "errors-only"
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format:check": {},
    "format": {},
    "lint": {},
    "lint:fix": {},
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "interactive": true,
      "persistent": true
    },
    "typecheck": {},
    "typecheck:watch": {
      "cache": false,
      "persistent": true
    }
  },
  "ui": "tui"
}
