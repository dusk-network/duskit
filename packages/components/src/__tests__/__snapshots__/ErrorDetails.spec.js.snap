// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ErrorDetails > should render nothing if the error is \`null\` 1`] = `null`;

exports[`ErrorDetails > should render the \`ErrorDetails\` component 1`] = `
<details
  class="dusk-error-details"
>
  <summary
    class="dusk-error-details__summary"
  >
    Some error summary
  </summary>
   
  <pre
    class="dusk-error-details__error"
  >
    
			Some error messaage
		
  </pre>
</details>
`;
