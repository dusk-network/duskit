// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RelativeTime > should render the relative time of the given date and should not update it by default 1`] = `
<time
  class="dusk-relative-time"
  datetime="2024-05-20T15:25:10.000Z"
>
  <!---->
  20 seconds ago
  
  <!---->
</time>
`;
