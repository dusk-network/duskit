{
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  },
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "!src/**/__{mocks,tests}__",
    "!src/**/.DS_Store"
  ],
  "license": "MPL-2.0",
  "main": "index.js",
  "module": "index.js",
  "name": "@duskit/components",
  "repository": {
    "type": "git",
    "url": "git@github.com:dusk-network/duskit.git",
    "directory": "packages/components"
  },
  "scripts": {
    "checks": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "clean": "rimraf node_modules coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:code": "eslint .",
    "lint:fix": "eslint . --fix && stylelint --quiet --rd 'src/**/*.css' --fix",
    "lint:styles": "stylelint --quiet --rd 'src/**/*.css'",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage.enabled",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "typecheck:watch": "svelte-check --tsconfig ./tsconfig.json --watch --fail-on-warnings"
  },
  "type": "module",
  "types": "index.d.ts",
  "version": "0.7.0",
  "dependencies": {
    "@duskit/date": "0.1.0",
    "@duskit/error": "0.0.2",
    "@duskit/string": "0.0.1",
    "@duskit/svelte-actions": "0.1.0",
    "@floating-ui/dom": "1.7.5",
    "@mdi/js": "7.4.47",
    "lamb": "0.61.1",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "svelte": "^4.2.0 || ^5.0.0"
  },
  "devDependencies": {
    "@dusk-network/eslint-config": "4.0.1",
    "@dusk-network/prettier-config": "1.1.0",
    "@dusk-network/stylelint-config": "1.0.6",
    "@duskit/test-helpers": "0.2.0",
    "@eslint/js": "9.39.4",
    "@juggle/resize-observer": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-istanbul": "4.1.3",
    "@vitest/eslint-plugin": "1.6.15",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-svelte": "3.17.0",
    "globals": "17.4.0",
    "jsdom": "29.0.2",
    "lamb-types": "0.61.16",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-no-unsupported-browser-features": "8.1.1",
    "stylelint-order": "8.1.1",
    "stylelint-selector-bem-pattern": "4.0.1",
    "svelte": "5.55.2",
    "svelte-check": "4.4.6",
    "vitest": "4.1.3",
    "vitest-canvas-mock": "1.1.4"
  }
}
