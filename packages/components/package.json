{
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  },
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "!src/**/__{mocks,tests}__",
    "!src/**/.DS_Store"
  ],
  "license": "MPL-2.0",
  "main": "index.js",
  "module": "index.js",
  "name": "@duskit/components",
  "repository": {
    "type": "git",
    "url": "git@github.com:dusk-network/duskit.git",
    "directory": "packages/components"
  },
  "scripts": {
    "checks": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "clean": "rimraf node_modules coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . && stylelint --quiet --rd 'src/**/*.css'",
    "lint:fix": "eslint . --fix && stylelint --quiet --rd 'src/**/*.css' --fix",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage.enabled",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "typecheck:watch": "svelte-check --tsconfig ./tsconfig.json --watch --fail-on-warnings"
  },
  "type": "module",
  "types": "index.d.ts",
  "version": "0.3.0",
  "dependencies": {
    "@duskit/date": "0.0.1",
    "@duskit/error": "0.0.2",
    "@duskit/string": "0.0.1",
    "@floating-ui/dom": "1.7.0",
    "@mdi/js": "7.4.47",
    "lamb": "0.61.1",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "svelte": "^4.2.0"
  },
  "devDependencies": {
    "@dusk-network/eslint-config": "4.0.1",
    "@dusk-network/prettier-config": "1.1.0",
    "@dusk-network/stylelint-config": "1.0.6",
    "@duskit/test-helpers": "0.1.0",
    "@eslint/js": "9.27.0",
    "@juggle/resize-observer": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "3.0.2",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/svelte": "5.2.7",
    "@tsconfig/svelte": "5.0.4",
    "@types/qrcode": "1.5.5",
    "@vitest/coverage-istanbul": "3.1.4",
    "@vitest/eslint-plugin": "1.1.44",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "4.3.5",
    "eslint-plugin-svelte": "3.6.0",
    "globals": "16.1.0",
    "jsdom": "26.1.0",
    "lamb-types": "0.61.14",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "stylelint": "16.19.1",
    "stylelint-config-standard": "38.0.0",
    "stylelint-no-unsupported-browser-features": "8.0.4",
    "stylelint-order": "7.0.0",
    "stylelint-selector-bem-pattern": "4.0.1",
    "svelte": "4.2.20",
    "svelte-check": "3.8.6",
    "vitest": "3.1.4",
    "vitest-canvas-mock": "0.3.3"
  }
}
