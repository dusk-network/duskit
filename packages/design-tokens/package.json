  "name": "@duskit/design-tokens",
  "repository": {
    "type": "git",
    "url": "git@github.com:dusk-network/duskit.git",
    "directory": "packages/design-tokens"
  },
  "scripts": {
    "build": "rimraf dist && node ./bin/build.js",
    "checks": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "clean": "rimraf node_modules dist",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage.enabled",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:watch": "tsc --watch --project tsconfig.json"
  },
  "type": "module",
  "version": "0.0.1",
  "devDependencies": {
    "@dusk-network/eslint-config": "4.0.1",
    "@dusk-network/prettier-config": "1.1.0",
    "@vitest/coverage-istanbul": "4.1.0",
    "@vitest/eslint-plugin": "1.6.12",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "globals": "17.4.0",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "style-dictionary": "5.3.0",
    "vitest": "4.1.0"
  }
}
