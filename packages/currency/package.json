{
  "name": "@duskit/currency",
  "version": "0.0.0",
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:dusk-network/duskit.git",
    "directory": "packages/currency"
  },
  "scripts": {
    "checks": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "clean": "rimraf node_modules coverage",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage.enabled",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:watch": "tsc --watch --project tsconfig.json"
  },
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "devDependencies": {
    "@dusk-network/eslint-config": "3.3.1",
    "@dusk-network/prettier-config": "1.1.0",
    "@vitest/coverage-istanbul": "1.4.0",
    "eslint": "8.57.0",
    "eslint-plugin-vitest": "0.4.1",
    "prettier": "3.2.5",
    "rimraf": "5.0.5",
    "typescript": "5.4.4",
    "vitest": "1.4.0"
  },
  "license": "MPL-2.0",
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  }
}
