{
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  },
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "!src/**/__{mocks,tests}__",
    "!src/**/.DS_Store"
  ],
  "license": "MIT",
  "main": "index.js",
  "module": "index.js",
  "name": "@duskit/test-helpers",
  "repository": {
    "type": "git",
    "url": "git@github.com:dusk-network/duskit.git",
    "directory": "packages/test-helpers"
  },
  "scripts": {
    "checks": "npm run format:check && npm run lint && npm run test:coverage",
    "clean": "rimraf node_modules coverage docs",
    "docs": "typedoc",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage.enabled",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "typecheck:watch": "svelte-check --tsconfig ./tsconfig.json --watch --fail-on-warnings"
  },
  "type": "module",
  "types": "index.d.ts",
  "version": "0.2.2",
  "peerDependencies": {
    "@testing-library/svelte": "^5.3.1",
    "svelte": "^4.2.0 || ^5.0.0"
  },
  "devDependencies": {
    "@dusk-network/eslint-config": "4.0.1",
    "@dusk-network/prettier-config": "1.1.0",
    "@eslint/js": "9.39.4",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@testing-library/svelte": "5.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@vitest/coverage-istanbul": "4.1.8",
    "@vitest/eslint-plugin": "1.6.19",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-svelte": "3.17.0",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "rimraf": "6.1.3",
    "svelte": "5.56.1",
    "svelte-check": "4.4.6",
    "typedoc": "0.28.19",
    "typedoc-plugin-dt-links": "2.0.57",
    "typedoc-plugin-mdn-links": "5.1.1",
    "vitest": "4.1.8"
  }
}
