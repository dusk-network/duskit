{
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  },
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "license": "MPL-2.0",
  "main": "index.js",
  "module": "index.js",
  "name": "@duskit/test-helpers",
  "repository": {
    "type": "git",
    "url": "git@github.com:dusk-network/duskit.git",
    "directory": "packages/test-helpers"
  },
  "scripts": {
    "checks": "npm run format:check && npm run lint && npm run test:coverage",
    "clean": "rimraf node_modules coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage.enabled",
    "test:watch": "vitest",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "typecheck:watch": "svelte-check --tsconfig ./tsconfig.json --watch --fail-on-warnings"
  },
  "type": "module",
  "version": "0.0.0",
  "devDependencies": {
    "@dusk-network/eslint-config": "4.0.1",
    "@dusk-network/prettier-config": "1.1.0",
    "@eslint/js": "9.27.0",
    "@sveltejs/vite-plugin-svelte": "3.0.2",
    "@testing-library/svelte": "5.2.7",
    "@tsconfig/svelte": "5.0.4",
    "@vitest/coverage-istanbul": "3.1.4",
    "@vitest/eslint-plugin": "1.1.44",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "4.3.5",
    "eslint-plugin-svelte": "3.6.0",
    "globals": "16.1.0",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "svelte": "4.2.19",
    "svelte-check": "3.8.6",
    "vitest": "3.1.4"
  }
}
