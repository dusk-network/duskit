{
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  },
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "files": [
    "src/**/*.css",
    "fonts/**/*"
  ],
  "license": "MPL-2.0",
  "name": "@duskit/css",
  "repository": {
    "type": "git",
    "url": "git@github.com:dusk-network/duskit.git",
    "directory": "packages/css"
  },
  "scripts": {
    "checks": "npm run format:check && npm run lint",
    "clean": "rimraf node_modules",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "lint": "stylelint --quiet --rd 'src/**/*.css'",
    "lint:fix": "stylelint --quiet --rd 'src/**/*.css' --fix"
  },
  "type": "module",
  "version": "0.1.0",
  "devDependencies": {
    "@dusk-network/prettier-config": "1.1.0",
    "@dusk-network/stylelint-config": "1.0.6",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-no-unsupported-browser-features": "8.1.1",
    "stylelint-order": "8.1.1",
    "stylelint-selector-bem-pattern": "4.0.1"
  }
}
