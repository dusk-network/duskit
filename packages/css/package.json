{
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  },
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "exports": {
    "./main.css": "./src/main.css",
    "./src/*": "./src/*",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "src/**/*.css",
    "fonts/**/*"
  ],
  "license": "MIT",
  "name": "@duskit/css",
  "repository": {
    "type": "git",
    "url": "git@github.com:dusk-network/duskit.git",
    "directory": "packages/css"
  },
  "scripts": {
    "checks": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "clean": "node -e \"const fs = require('node:fs'); for (const path of process.argv.slice(1)) fs.rmSync(path, { force: true, recursive: true })\" node_modules",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "npm run lint:code && npm run lint:styles",
    "lint:code": "eslint .",
    "lint:fix": "eslint . --fix && stylelint --quiet --rd 'src/**/*.css' --fix",
    "lint:styles": "stylelint --quiet --rd 'src/**/*.css'",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage.enabled",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:watch": "tsc --watch --project tsconfig.json"
  },
  "type": "module",
  "version": "1.1.0",
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "colorjs.io": "0.6.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "postcss": "8.5.25",
    "prettier": "3.8.4",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
