{
  "author": {
    "name": "Dusk Network B.V.",
    "url": "https://dusk.network/",
    "mail": "info@dusk.network"
  },
  "bugs": {
    "url": "https://github.com/dusk-network/duskit/issues"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "!src/**/__{mocks,tests}__",
    "!src/**/.DS_Store"
  ],
  "license": "MPL-2.0",
  "main": "index.js",
  "module": "index.js",
  "name": "@duskit/svelte-stores",
  "repository": {
    "type": "git",
    "url": "git@github.com:dusk-network/duskit.git",
    "directory": "packages/svelte-stores"
  },
  "scripts": {
    "checks": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "clean": "rimraf node_modules coverage docs",
    "docs": "typedoc",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage.enabled",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:watch": "tsc --watch --project tsconfig.json"
  },
  "type": "module",
  "types": "index.d.ts",
  "version": "0.1.1",
  "dependencies": {
    "@duskit/error": "0.0.2",
    "@duskit/promise": "0.0.1",
    "svelte": "4.2.20"
  },
  "devDependencies": {
    "@dusk-network/eslint-config": "4.0.1",
    "@dusk-network/prettier-config": "1.1.0",
    "@eslint/js": "9.27.0",
    "@vitest/coverage-istanbul": "3.1.4",
    "@vitest/eslint-plugin": "1.1.44",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "4.3.5",
    "globals": "16.1.0",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "typedoc": "0.28.7",
    "typedoc-plugin-dt-links": "2.0.8",
    "typedoc-plugin-mdn-links": "5.0.2",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
