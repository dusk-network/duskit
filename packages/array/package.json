  },
  "scripts": {
    "checks": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "clean": "node -e \"const fs = require('node:fs'); for (const path of process.argv.slice(1)) fs.rmSync(path, { force: true, recursive: true })\" node_modules coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage.enabled",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:watch": "tsc --watch --project tsconfig.json"
  },
  "type": "module",
  "types": "index.d.ts",
  "version": "0.0.3",
